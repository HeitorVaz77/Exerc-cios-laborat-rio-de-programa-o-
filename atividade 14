3- Criar uma matriz 3×3, somar todos os seus elementos e apresentar o resultado. 
 

#include <stdio.h>

int main() {
    int matriz[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    int soma = 0;

    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            soma += matriz[i][j];
        }
    }

    printf("A soma dos elementos da matriz e: %d\n", soma);

    return 0;
}
